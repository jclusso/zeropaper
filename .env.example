# Copy to .env and fill in. Only SECRET_KEY_BASE and POSTGRES_PASSWORD are required.

# Generate with: openssl rand -hex 64
# Encryption keys for private files and encrypted text are derived from this
# value. If you lose it, private files and encrypted text cannot be read.
# Back it up together with the storage volume.
SECRET_KEY_BASE=

# Password for the bundled Postgres database.
POSTGRES_PASSWORD=

# AI providers and their keys are added in the setup wizard or under
# Admin > Settings, not here.

# Time zone for dates shown in the app.
TZ=UTC

# Port on the host where the app is published.
PORT=3000

# Host name the app is served under, e.g. docs.example.com. When set, requests
# for other hosts are refused. Passkeys also depend on the host name.
APP_HOST=

# Set to true when a reverse proxy terminates TLS in front of the app.
ASSUME_SSL=false
# Set to true to redirect HTTP to HTTPS and mark cookies secure.
FORCE_SSL=false

# Documents processed at the same time. Each one mostly waits on Tesseract or
# an AI provider, so this can go higher on machines with more cores.
PROCESSING_THREADS=6
