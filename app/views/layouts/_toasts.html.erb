<%# The stack toasts move into. Permanent, so a toast survives the page refreshes that follow it. %>
<div id="toasts" data-turbo-permanent aria-live="polite"
  class="pointer-events-none fixed inset-x-0 top-0 z-[60] flex flex-col items-center gap-2 p-3 sm:inset-x-auto sm:top-auto sm:right-0 sm:bottom-0 sm:w-96 sm:items-end sm:p-5"></div>
