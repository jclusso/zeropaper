<%# The Inbox count in the sidebar, replaced by a broadcast whenever it changes. %>
<% count = Document.in_inbox.count %>
<%= tag.span count, id: "inbox_count", class: "rounded-xs bg-strong-accent px-1.5 py-px text-[0.7rem] font-bold text-strong-accent-foreground tabular-nums", hidden: count.zero? %>
