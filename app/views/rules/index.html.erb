<% content_for :title, "Rules" %>
<div class="mx-auto max-w-5xl">
  <%= page_header "Rules", "File documents automatically: set a correspondent and type, add tags, or mark them private. Rules run on this machine before anything is sent out." do %>
    <% if current_user.admin? %>
      <%= link_to new_rule_path, class: "btn-primary" do %><%= icon(:plus, class: "size-4") %> New rule<% end %>
    <% end %>
  <% end %>

  <div class="callout mb-6">
    <%= icon(:info, class: "mt-0.5 size-4 shrink-0 muted") %>
    <p class="text-xs muted">
      Rules that look only at the filename or source run when a document arrives. Rules that look at the text run on text read locally, before any hosted OCR or AI.
      Rules win over details found by name or suggested by AI. Correspondents, types and tags can also match by name; turn that on or off on each one.
    </p>
  </div>

  <% if @rules.empty? %>
    <div class="card card-body flex flex-col items-center py-14 text-center">
      <%= icon(:rules, class: "size-8 muted") %>
      <p class="mt-4 font-bold">No rules yet.</p>
      <p class="mt-1 max-w-md text-sm muted">For example: when the text contains “IBAN” and “statement”, set the correspondent to your bank, tag it Finance and mark it private.</p>
    </div>
  <% else %>
    <ul class="space-y-3">
      <% @rules.each do |rule| %>
        <li class="card flex flex-wrap items-start gap-4 p-4">
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <p class="font-bold"><%= rule.name %></p>
              <% unless rule.enabled? %><span class="badge-slate">Off</span><% end %>
              <% if rule.mark_private? %><%= private_badge %><% end %>
            </div>
            <p class="mt-2 text-xs"><span class="eyebrow mr-1.5">When</span><%= rule_conditions_summary(rule) %></p>
            <p class="mt-1 text-xs"><span class="eyebrow mr-1.5">Then</span><%= rule_actions_summary(rule) %></p>
          </div>
          <% if current_user.admin? %>
            <%= link_to "Edit", edit_rule_path(rule), class: "btn-secondary btn-sm" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
