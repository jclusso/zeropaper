<% content_for :title, "Rules" %>
<div class="mx-auto max-w-5xl">
  <% when_rules_run = "A rule about the filename or source runs as soon as a file arrives. A rule about the text runs once the text is read on this machine, before any AI sees the document. What a rule sets wins over AI suggestions and name matches." %>
  <%= page_header "Rules", safe_join([ "File documents automatically: set a correspondent and type, add tags, or mark them private. Rules run on this machine before anything is sent out. ",
        tag.span(render("shared/info_tip", text: when_rules_run, id: "rules_timing_tip", about: "when rules run"), class: "inline-flex align-[-3px]") ]) do %>
    <% if current_user.admin? %>
      <%= link_to new_rule_path, class: "btn-primary" do %><%= icon(:plus, class: "size-4") %> New rule<% end %>
    <% end %>
  <% end %>

  <% if @rules.empty? %>
    <div class="card card-body flex flex-col items-center py-14 text-center">
      <%= icon(:rules, class: "size-8 muted") %>
      <p class="mt-4 font-bold">No rules yet.</p>
      <p class="mt-1 max-w-md text-sm muted">For example: when the text contains “IBAN” and “statement”, set the correspondent to your bank, tag it Finance and mark it private.</p>
    </div>
  <% else %>
    <ul class="space-y-3">
      <% @rules.each do |rule| %>
        <li class="card flex flex-wrap items-start gap-4 p-4">
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <p class="font-bold"><%= rule.name %></p>
              <% unless rule.enabled? %><span class="badge-slate">Off</span><% end %>
            </div>
            <p class="mt-2 text-xs"><span class="eyebrow mr-1.5">When</span><%= rule_conditions_summary(rule) %></p>
            <p class="mt-1 text-xs"><span class="eyebrow mr-1.5">Then</span><%= rule_actions_summary(rule) %></p>
            <% unless rule.enabled? || rule.action? %><%= render "rules/actionless_note" %><% end %>
          </div>
          <% if current_user.admin? %>
            <%= link_to "Edit", edit_rule_path(rule), class: "btn-secondary btn-sm" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
