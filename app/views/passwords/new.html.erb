<% content_for :title, "Reset Password" %>
<div class="card card-body">
  <h1 class="text-lg font-bold">Forgot Your Password?</h1>
  <% if ApplicationMailer.deliverable? %>
    <p class="mt-1 text-sm muted">We will email you a link to choose a new one.</p>
    <%= form_with url: passwords_path, class: "mt-6 space-y-4" do |form| %>
      <div>
        <%= form.label :email_address, "Email", class: "label" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], placeholder: "you@example.com", class: "input" %>
      </div>
      <%= form.submit "Email reset link", class: "btn-primary w-full" %>
    <% end %>
  <% else %>
    <%= render "passwords/mail_off" %>
  <% end %>
  <p class="mt-4 text-center text-sm"><%= link_to "Back to sign in", new_session_path, class: "link" %></p>
</div>
