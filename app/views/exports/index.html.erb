<% content_for :title, "Export" %>
<% if @exports.any? { |export| export.status.in?(%w[pending processing]) } %>
  <meta data-controller="refresh" data-refresh-interval-value="3000">
<% end %>
<div class="space-y-6">
  <%= page_header "Export", "Everything in one zip: files, OCR text, details, thumbnails, correspondents, types, tags and rules. Restore it here or into another ZeroPaper." %>

  <div class="card card-body">
    <h2 class="section-title">New Export</h2>
    <%= form_with url: exports_path, class: "mt-4 space-y-4" do |form| %>
      <%= render "shared/switch", name: :include_private, checked: true, title: safe_join([ "Include ", private_badge(interactive: false), " documents" ]),
            description: "They are decrypted into the zip, so keep the file somewhere safe." %>
      <div class="flex justify-end border-t border-border pt-4"><%= form.submit "Export library", class: "btn-primary" %></div>
    <% end %>
  </div>

  <% if @exports.any? %>
    <div class="card overflow-x-auto">
      <table class="table">
        <thead><tr><th>Started</th><th>By</th><th>Documents</th><th>Status</th><th></th></tr></thead>
        <tbody>
          <% @exports.each do |export| %>
            <tr>
              <td><%= export.created_at.to_fs(:long) %></td>
              <td class="muted"><%= export.user.name %></td>
              <td class="tabular-nums"><%= export.documents_count || "…" %><%= tag.span(" incl. private", class: "muted") if export.include_private? %></td>
              <td><%= { "ready" => tag.span("Ready", class: "badge-green"), "failed" => tag.span("Failed", class: "badge-red", title: export.error) }.fetch(export.status) { tag.span("Working", class: "badge-accent") } %></td>
              <td class="text-right"><% if export.status == "ready" %><%= link_to export_path(export), class: "btn-secondary btn-sm", data: { turbo: false } do %><%= icon(:download, class: "size-3.5") %> Download<% end %><% end %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

</div>
