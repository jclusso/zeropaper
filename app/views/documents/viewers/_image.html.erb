<div class="absolute inset-0 flex flex-col" data-controller="image-viewer">
  <div class="flex items-center gap-1 border-b border-border bg-background/95 px-2 py-1.5 text-sm">
    <button type="button" class="btn-icon" data-action="image-viewer#zoomOut" aria-label="Zoom out"><%= icon(:minus, class: "size-4") %></button>
    <span class="w-12 text-center tabular-nums muted" data-image-viewer-target="zoom">100%</span>
    <button type="button" class="btn-icon" data-action="image-viewer#zoomIn" aria-label="Zoom in"><%= icon(:plus, class: "size-4") %></button>
    <button type="button" class="btn-ghost btn-sm" data-action="image-viewer#fit">Fit</button>
  </div>
  <div class="min-h-0 flex-1 overflow-auto p-6">
    <%= image_tag document_file_path(document, v: document.file.blob.id), alt: document.display_title, class: "mx-auto max-w-none rounded shadow-xl", data: { image_viewer_target: "image" } %>
  </div>
</div>
