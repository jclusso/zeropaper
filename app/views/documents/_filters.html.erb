<%= form_with url: request.path, method: :get, class: "mb-6 grid grid-cols-1 items-end gap-3 border-y border-border bg-background/60 py-3 sm:grid-cols-[repeat(auto-fill,minmax(13rem,1fr))]", data: { controller: "auto-submit", turbo_action: "replace" } do |form| %>
  <%= hidden_field_tag :view, view if local_assigns[:view] == "timeline" %>
  <%= hidden_field_tag :q, params[:q] if params[:q].present? %>
  <% Array(params[:literal]).compact_blank.each do |phrase| %><%= hidden_field_tag "literal[]", phrase, id: nil %><% end %>
  <%= hidden_field_tag :ai, "1" if params[:ai] == "1" %>
  <%# Taxonomy lists can grow long, so they are searchable; privacy and status are short fixed lists.
      Types match any chosen one; tags match documents that have all chosen ones. %>
  <% fixed = [
       [ :privacy, "Privacy", [ [ safe_join([ icon(:lock, class: "mr-1.5 inline size-3.5 align-[-2px] text-private"), tag.span("Private", class: "text-private") ]), "private" ],
                               [ safe_join([ icon(:lock_open, class: "mr-1.5 inline size-3.5 align-[-2px] muted"), "Not private" ]), "shareable" ] ] ],
       [ :status, "Status", Document::STATUSES.map { |status| [ status.capitalize, status ] } ]
     ] %>
  <div>
    <%= form.label :correspondent_id, "Correspondent", class: "label", for: "filter_correspondent_id" %>
    <%= render "shared/combobox", name: :correspondent_id, value: filters["correspondent_id"], options: Correspondent.alphabetically.pluck(:name, :id),
          id: "filter_correspondent_id", placeholder: "Any", clearable: true, data: { action: "change->auto-submit#submit" } %>
  </div>
  <div>
    <%= form.label :document_type_ids, "Type", class: "label", for: "filter_document_type_ids" %>
    <%= render "shared/multi_select", name: "document_type_ids[]", selected: filters["document_type_ids"], id: "filter_document_type_ids", noun: "types",
          options: DocumentType.alphabetically.pluck(:name, :id), data: { action: "multi-select:change->auto-submit#submit" } %>
  </div>
  <div>
    <%= form.label :tag_ids, "Tags", class: "label", for: "filter_tag_ids" %>
    <%= render "shared/multi_select", name: "tag_ids[]", selected: filters["tag_ids"], id: "filter_tag_ids", noun: "tags",
          options: Tag.alphabetically.map { |option_tag| [ option_tag.name, option_tag.id, tag_chip_class(option_tag) ] },
          data: { action: "multi-select:change->auto-submit#submit" } %>
  </div>
  <% fixed.each do |name, label, options| %>
    <div>
      <%= form.label name, label, class: "label", for: "filter_#{name}" %>
      <%= render "shared/select", name: name, value: filters[name.to_s].to_s, options: [ [ "Any", "" ] ] + options, id: "filter_#{name}",
            data: { action: "change->auto-submit#submit" } %>
    </div>
  <% end %>
  <div>
    <label class="label" for="filter_date_from">From</label>
    <%= render "shared/date_picker", name: "date_from", value: filters["date_from"], id: "filter_date_from", placeholder: "Any date",
          data: { action: "change->auto-submit#submit" } %>
  </div>
  <div>
    <label class="label" for="filter_date_to">To</label>
    <%= render "shared/date_picker", name: "date_to", value: filters["date_to"], id: "filter_date_to", placeholder: "Any date",
          data: { action: "change->auto-submit#submit" } %>
  </div>
  <% if filters.any? %>
    <div><%= link_to "Clear", request.path + (params[:q].present? ? "?q=#{CGI.escape(params[:q])}" : ""), class: "btn-ghost" %></div>
  <% end %>
  <noscript><%= form.submit "Filter", class: "btn-secondary" %></noscript>
<% end %>
