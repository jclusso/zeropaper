<tr>
  <td><%= backup.created_at.to_fs(:long) %></td>
  <td class="hidden muted md:table-cell"><%= backup.user&.name || "Schedule" %></td>
  <td class="hidden sm:table-cell"></td>
  <td class="text-right">
    <% if backup.status == "failed" %>
      <%= render layout: "shared/tooltip", locals: { text: backup.error.presence || "The backup failed.", tone: "danger" } do %><span class="badge-red cursor-help">Failed</span><% end %>
    <% else %>
      <span class="badge-accent">Backing up</span>
    <% end %>
  </td>
</tr>
