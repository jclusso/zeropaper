<% content_for :title, "Restore" %>
<% if @restores.any? { |restore| restore.status.in?(%w[pending processing]) } %>
  <meta data-controller="refresh" data-refresh-interval-value="3000">
<% end %>
<div>
  <%= page_header "Restore", "Import a ZeroPaper export into this library. Documents already here are skipped." %>
  <%= form_with url: restores_path, multipart: true, class: "card card-body space-y-5" do |form| %>
    <div>
      <%= form.label :archive, "Export file", class: "label" %>
      <%= form.file_field :archive, accept: ".zip,application/zip", required: true, class: "block w-full text-sm file:mr-4 file:h-9 file:cursor-pointer file:rounded-sm file:border file:border-border file:bg-card file:px-4 file:text-xs file:font-semibold file:uppercase file:tracking-wide file:text-foreground hover:file:bg-muted" %>
      <p class="hint">Documents keep their details and text and are indexed again locally. Nothing is sent to an AI provider.</p>
    </div>
    <div class="flex justify-end"><%= form.submit "Restore", class: "btn-primary" %></div>
  <% end %>

  <% if @restores.any? %>
    <ul class="card mt-6 divide-y divide-border text-sm">
      <% @restores.each do |restore| %>
        <li class="flex items-center justify-between gap-3 px-4 py-3">
          <%= link_to "Restore of #{restore.created_at.to_fs(:long)}", restore, class: "link" %>
          <span class="muted"><%= restore.status.capitalize %> · <%= restore.restored_count %> restored, <%= restore.skipped_count %> skipped</span>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
