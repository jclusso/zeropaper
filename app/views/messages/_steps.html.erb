<%# One line above the answer: the live step while researching, a collapsible list once done. %>
<% labels = research_step_labels(message) %>
<% if message.streaming? %>
  <p class="flex items-center gap-2.5 py-1 text-xs muted" data-research-status>
    <%= icon(:refresh, class: "size-3.5 shrink-0 animate-spin text-strong-accent") %>
    <span class="shimmer truncate"><%= labels.last || "Thinking" %></span>
  </p>
<% elsif labels.any? %>
  <details class="group text-xs">
    <summary class="flex w-fit cursor-pointer list-none items-center gap-2 muted transition-colors hover:text-foreground [&::-webkit-details-marker]:hidden">
      <%= icon(message.status == "failed" ? :warning : :check, class: "size-3.5 shrink-0") %>
      <span><%= message.status == "failed" ? "Stopped" : "Researched" %> · <%= pluralize(labels.size, "step") %></span>
      <%= icon(:chevron_down, class: "size-3.5 transition-transform group-open:rotate-180") %>
    </summary>
    <ol class="ml-[0.4rem] mt-2 space-y-1.5 border-l border-border pl-[1.1rem]">
      <% labels.each do |label| %><li class="muted"><%= label %></li><% end %>
    </ol>
  </details>
<% end %>
