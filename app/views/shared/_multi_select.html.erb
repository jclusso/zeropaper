<%#
  Dropdown for picking several values in a filter bar. It stays the height of
  the other fields and sums up the choice ("Taxes +2"); the menu has a search
  box and a checkbox per option. Fires `multi-select:change` when the menu
  closes after the choice changed, so a filter form submits once.

  locals: name: (e.g. "tag_ids[]"), options: [[label, value, chip_class], ...], selected: [values],
          id:, placeholder: (default "Any"), noun: (for the search box, e.g. "tags"), data: (on the wrapper)
%>
<% selected_values = Array(selected).map(&:to_s) %>
<% menu_id = "#{id}_menu" %>
<% chosen = options.select { |_label, value| selected_values.include?(value.to_s) }.map(&:first) %>
<%= tag.div class: "relative", data: { controller: "multi-select", multi_select_placeholder_value: local_assigns[:placeholder] || "Any" }.merge(local_assigns[:data] || {}) do %>
  <button type="button" id="<%= id %>" popovertarget="<%= menu_id %>" class="input grid cursor-default grid-cols-1 text-left">
    <span class="col-start-1 row-start-1 truncate pr-6 <%= "muted" if chosen.empty? %>" title="<%= chosen.join(", ") %>" data-multi-select-target="summary"><%= chosen.any? ? "#{chosen.first}#{" +#{chosen.size - 1}" if chosen.size > 1}" : local_assigns[:placeholder] || "Any" %></span>
    <%= icon(:chevron_down, class: "col-start-1 row-start-1 size-4 self-center justify-self-end muted") %>
  </button>
  <el-popover id="<%= menu_id %>" anchor="bottom start" popover data-multi-select-target="menu" data-action="toggle->multi-select#toggled"
              class="menu w-(--button-width) min-w-56 p-0 [--anchor-gap:--spacing(1)]">
    <% if options.size > 6 %>
      <div class="border-b border-border p-1.5">
        <input type="search" class="input h-8 text-xs" placeholder="find <%= local_assigns[:noun] || "options" %>" <%= tag.attributes(no_autofill) %> aria-label="Find <%= local_assigns[:noun] || "options" %>"
               data-multi-select-target="search" data-action="input->multi-select#filter keydown.enter->multi-select#pickFirst keydown.esc->multi-select#close">
      </div>
    <% end %>
    <div class="max-h-64 overflow-auto p-1">
      <% options.each do |label, value, chip_class| %>
        <label class="menu-item relative pr-9" data-multi-select-target="option" data-label="<%= label %>">
          <input type="checkbox" name="<%= name %>" value="<%= value %>" class="peer sr-only" <%= "checked" if selected_values.include?(value.to_s) %>
                 data-multi-select-target="checkbox" data-action="multi-select#changed">
          <% if chip_class %><span class="<%= chip_class %>"><%= label %></span><% else %><span class="truncate peer-checked:font-bold"><%= label %></span><% end %>
          <span class="absolute inset-y-0 right-0 hidden items-center pr-3 text-strong-accent peer-checked:flex"><%= icon(:check, class: "size-4") %></span>
        </label>
      <% end %>
      <p class="px-2.5 py-2 text-sm muted" data-multi-select-target="empty" hidden>No matches.</p>
    </div>
    <div class="flex justify-end border-t border-border p-1.5" data-multi-select-target="footer" <%= "hidden" if chosen.empty? %>>
      <button type="button" class="btn-ghost btn-sm" data-action="multi-select#clear">Clear</button>
    </div>
  </el-popover>
<% end %>
