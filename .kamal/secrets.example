# Copy to .kamal/secrets (gitignored). Values here come from your environment;
# a password manager works too, e.g. $(op read op://Vault/ZeroPaper/secret_key_base).
#
# SECRET_KEY_BASE also derives the encryption keys for private documents.
# Losing it makes private files and encrypted text unreadable, so keep a copy.

SECRET_KEY_BASE=$SECRET_KEY_BASE
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
DATABASE_URL=postgres://zeropaper:$POSTGRES_PASSWORD@zeropaper-db/zeropaper_production
